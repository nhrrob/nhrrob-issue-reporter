{
	"name": "nhrrob-issue-reporter",
	"version": "0.5.1",
	"description": "React admin app for NHR Issue Reporter.",
	"author": "Nazmul Hasan Robin",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"start": "wp-scripts start admin/src/index.js admin/src/widget.js --output-path=admin/build",
		"build": "wp-scripts build admin/src/index.js admin/src/widget.js --output-path=admin/build",
		"lint:js": "wp-scripts lint-js admin/src",
