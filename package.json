		"prepare": "git config core.hooksPath .husky || true"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0",
		"typescript": "~6.0.3"
	},
	"dependencies": {
		"html2canvas-pro": "2.6.4"
	}
